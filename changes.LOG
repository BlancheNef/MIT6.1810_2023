@@ -256,7 +256,9 @@ create(char *path, short type, short major, short minor)
   if((ip = dirlookup(dp, name, 0)) != 0){
     iunlockput(dp);
     ilock(ip);
-    if(type == T_FILE && (ip->type == T_FILE || ip->type == T_DEVICE))
+    if(type == T_FILE && (ip->type == T_FILE || ip->type == T_DEVICE)) 
+      return ip;
+    if(type ==T_SYMLINK && ip->type == T_SYMLINK) // exits already, do not create.
       return ip;
     iunlockput(ip);
     return 0;
@@ -341,6 +343,28 @@ sys_open(void)
     return -1;
   }
 
+  const int  max_dep = 10;
+  int dep = 0;
+  char sym_path[MAXPATH];
+  while(ip->type == T_SYMLINK){
+    if(dep > max_dep) {
+      iunlockput(ip);
+      end_op();
+      return -1;
+    }
+    dep++;
+    if(omode & O_NOFOLLOW)
+      break;
+    readi(ip, 0, (uint64)sym_path, 0, MAXPATH);
+    iunlockput(ip);
+    if((ip = namei(sym_path)) == 0){
+      end_op();
+      return -1;
+    }
+    ilock(ip);
+  }
+
+
   if((f = filealloc()) == 0 || (fd = fdalloc(f)) < 0){
     if(f)
       fileclose(f);
@@ -503,3 +527,36 @@ sys_pipe(void)
   }
   return 0;
 }
+
+uint64
+sys_symlink(void)
+{
+  char target[MAXPATH], path[MAXPATH];
+  struct inode *ip;
+
+  if(argstr(0, target, MAXPATH) < 0 || argstr(1, path, MAXPATH) < 0)
+    return -1;
+
+  begin_op();
+
+  // Note that target does not need to exist for the system call to succeed.
+  if((ip = create(path, T_SYMLINK, 0, 0)) == 0) {
+    end_op();
+    return -1;
+  }
+
+  // create return a locked ip;
+  // write the target
+  if(writei(ip, 0, (uint64)target, 0, MAXPATH) < MAXPATH) {
+    // error
+    ip->nlink = 0;
+    iunlockput(ip);
+    end_op();
+  }
+
+  iupdate(ip);
+  iunlockput(ip);
+  end_op();
+
+  return 0;
+}
